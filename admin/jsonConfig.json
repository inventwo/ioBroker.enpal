{
	"i18n": true,
	"type": "tabs",
	"items": {
		"_settings": {
			"type": "panel",
			"label": "tab_settings",
			"icon": "data:image/svg+xml;base64,",
			"items": {
				"_info": {
					"type": "header",
					"text": "ENPAL InfluxDB Configuration",
					"size": 3
				},
				"influx_url": {
					"type": "text",
					"label": "influx_url",
					"help": "influx_url_help",
					"newLine": true,
					"default": "http://localhost:8086",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"influx_token": {
					"type": "password",
					"label": "influx_token",
					"help": "influx_token_help",
					"newLine": true,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"influx_org": {
					"type": "text",
					"label": "influx_org",
					"help": "influx_org_help",
					"newLine": true,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"influx_bucket": {
					"type": "text",
					"label": "influx_bucket",
					"help": "influx_bucket_help",
					"newLine": true,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"interval_s": {
					"type": "number",
					"label": "interval_s",
					"help": "interval_s_help",
					"newLine": true,
					"default": 60,
					"min": 5,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"show_sync_info": {
					"type": "checkbox",
					"label": "show_sync_info",
					"help": "show_sync_info_help",
					"newLine": true,
					"default": false,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"_wallbox_header": {
					"type": "header",
					"text": "wallbox_section_header",
					"size": 4,
					"newLine": true
				},
				"wallbox_enabled": {
					"type": "checkbox",
					"label": "wallbox_enabled",
					"help": "wallbox_enabled_help",
					"newLine": true,
					"default": false,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				}
			}
		},
		"_wallbox_help": {
			"type": "panel",
			"label": "tab_wallbox_help",
			"icon": "data:image/svg+xml;base64,",
			"hidden": "js: !data.wallbox_enabled",
			"items": {
				"wallbox_help_intro": {
					"type": "staticText",
					"text": "wallbox_help_intro",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"style": {
						"fontSize": "16px",
						"marginBottom": "20px"
					}
				},
				"wallbox_help_states": {
					"type": "staticText",
					"text": "wallbox_help_states",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"style": {
						"fontSize": "14px",
						"marginBottom": "20px"
					}
				},
				"wallbox_help_modes": {
					"type": "staticText",
					"text": "wallbox_help_modes",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"style": {
						"fontSize": "14px",
						"marginBottom": "20px"
					}
				},
				"wallbox_help_connector": {
					"type": "staticText",
					"text": "wallbox_help_connector",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"style": {
						"fontSize": "14px",
						"marginBottom": "20px"
					}
				},
				"wallbox_help_automation": {
					"type": "staticText",
					"text": "wallbox_help_automation",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"style": {
						"fontSize": "14px",
						"marginBottom": "20px"
					}
				},
				"wallbox_help_readme": {
					"type": "staticText",
					"text": "wallbox_help_readme",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"style": {
						"fontSize": "14px",
						"marginTop": "10px"
					}
				}
			}
		}
	}
}
