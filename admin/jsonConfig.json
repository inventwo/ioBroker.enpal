{
	"i18n": true,
	"type": "tabs",
	"items": {
		"_settings": {
			"type": "panel",
			"label": "tab_settings",
			"icon": "data:image/svg+xml;base64,",
			"items": {
				"_info": {
					"type": "header",
					"text": "ENPAL InfluxDB Configuration",
					"size": 3
				},
				"influx_url": {
					"type": "text",
					"label": "influx_url",
					"help": "influx_url_help",
					"newLine": true,
					"default": "http://localhost:8086",
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"influx_token": {
					"type": "password",
					"label": "influx_token",
					"help": "influx_token_help",
					"newLine": true,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"influx_org": {
					"type": "text",
					"label": "influx_org",
					"help": "influx_org_help",
					"newLine": true,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"influx_bucket": {
					"type": "text",
					"label": "influx_bucket",
					"help": "influx_bucket_help",
					"newLine": true,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"interval_s": {
					"type": "number",
					"label": "interval_s",
					"help": "interval_s_help",
					"newLine": true,
					"default": 60,
					"min": 5,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"show_sync_info": {
					"type": "checkbox",
					"label": "show_sync_info",
					"help": "show_sync_info_help",
					"newLine": true,
					"default": false,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				},
				"_wallbox_header": {
					"type": "header",
					"text": "wallbox_section_header",
					"size": 4,
					"newLine": true
				},
				"wallbox_enabled": {
					"type": "checkbox",
					"label": "wallbox_enabled",
					"help": "wallbox_enabled_help",
					"newLine": true,
					"default": false,
					"xs": 12,
					"sm": 6,
					"md": 6,
					"lg": 6,
					"xl": 6
				}
			}
		},
		"_wallbox_help": {
			"type": "panel",
			"label": "tab_wallbox_help",
			"icon": "data:image/svg+xml;base64,",
			"hidden": "js: !data.wallbox_enabled",
			"items": {
				"wallbox_help_intro": {
					"type": "staticText",
					"text": "wallbox_help_intro",
					"format": "html",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"style": {
						"fontSize": "0.875rem",
						"marginBottom": "16px"
					}
				},
				"_wallboxStatesHeader": {
					"type": "header",
					"text": "wallbox_help_section_states",
					"size": 4,
					"newLine": true
				},
				"_docWallboxStates": {
					"type": "table",
					"noDelete": true,
					"compact": true,
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"default": [
						{
							"state": "start",
							"read": "no",
							"write": "yes",
							"desc": {
								"en": "Button — set to true to start charging",
								"de": "Button — auf true setzen zum Starten"
							}
						},
						{
							"state": "stop",
							"read": "no",
							"write": "yes",
							"desc": {
								"en": "Button — set to true to stop charging",
								"de": "Button — auf true setzen zum Stoppen"
							}
						},
						{
							"state": "mode",
							"read": "yes",
							"write": "yes",
							"desc": {
								"en": "Set charge mode: eco, solar, full, smart",
								"de": "Lademodus setzen: eco, solar, full, smart"
							}
						},
						{
							"state": "currentMode",
							"read": "yes",
							"write": "no",
							"desc": {
								"en": "Current mode reported by the wallbox (e.g. Eco, Solar, Full)",
								"de": "Aktueller Modus laut Wallbox (z. B. Eco, Solar, Full)"
							}
						},
						{
							"state": "connectorStatus",
							"read": "yes",
							"write": "no",
							"desc": {
								"en": "OCPP connector status (see table below)",
								"de": "OCPP Connector-Status (siehe Tabelle unten)"
							}
						},
						{
							"state": "automaticChargeStatus",
							"read": "yes",
							"write": "no",
							"desc": {
								"en": "Automatic charge on plug-in: On / Off (read-only, change in Enpal app)",
								"de": "Automatisches Laden beim Einstecken: On / Off (nur lesen — Enpal-App)"
							}
						}
					],
					"items": [
						{
							"title": "wallbox_doc_col_state",
							"attr": "state",
							"type": "text",
							"readOnly": true,
							"width": "18%"
						},
						{
							"title": "wallbox_doc_col_read",
							"attr": "read",
							"type": "text",
							"readOnly": true,
							"width": "10%"
						},
						{
							"title": "wallbox_doc_col_write",
							"attr": "write",
							"type": "text",
							"readOnly": true,
							"width": "10%"
						},
						{
							"title": "wallbox_doc_col_desc",
							"attr": "desc",
							"type": "text",
							"readOnly": true,
							"width": "62%"
						}
					]
				},
				"_wallboxModesHeader": {
					"type": "header",
					"text": "wallbox_help_section_modes",
					"size": 4,
					"newLine": true
				},
				"_docWallboxModes": {
					"type": "table",
					"noDelete": true,
					"compact": true,
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"default": [
						{
							"mode": "eco",
							"desc": {
								"en": "Eco — cost- or grid-optimised charging",
								"de": "Eco — kosten- bzw. netzoptimiertes Laden"
							}
						},
						{
							"mode": "solar",
							"desc": {
								"en": "Solar — prefer PV surplus",
								"de": "Solar — bevorzugt PV-Überschuss"
							}
						},
						{
							"mode": "full",
							"desc": {
								"en": "Full / fast — maximum charging power",
								"de": "Full / Fast — maximale Ladeleistung"
							}
						},
						{
							"mode": "smart",
							"desc": {
								"en": "Smart — Enpal-managed charging strategy",
								"de": "Smart — von Enpal gesteuerte Ladestrategie"
							}
						}
					],
					"items": [
						{
							"title": "wallbox_doc_col_mode",
							"attr": "mode",
							"type": "text",
							"readOnly": true,
							"width": "18%"
						},
						{
							"title": "wallbox_doc_col_desc",
							"attr": "desc",
							"type": "text",
							"readOnly": true,
							"width": "82%"
						}
					]
				},
				"_wallboxConnectorHeader": {
					"type": "header",
					"text": "wallbox_help_section_connector",
					"size": 4,
					"newLine": true
				},
				"_docWallboxConnector": {
					"type": "table",
					"noDelete": true,
					"compact": true,
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"default": [
						{
							"value": "Available",
							"meaning": {
								"en": "Connector free, nothing plugged in",
								"de": "Anschluss frei, nichts eingesteckt"
							}
						},
						{
							"value": "Preparing",
							"meaning": {
								"en": "Vehicle connected, session not started yet",
								"de": "Fahrzeug verbunden, Session noch nicht gestartet"
							}
						},
						{
							"value": "Charging",
							"meaning": {
								"en": "Active charging — power is flowing",
								"de": "Aktives Laden — Strom fließt"
							}
						},
						{
							"value": "SuspendedEV",
							"meaning": {
								"en": "Vehicle paused (e.g. battery full); still plugged in",
								"de": "Fahrzeug pausiert (z. B. Akku voll); noch eingesteckt"
							}
						},
						{
							"value": "SuspendedEVSE",
							"meaning": {
								"en": "Wallbox paused power (e.g. load management)",
								"de": "Wallbox pausiert (z. B. Lastmanagement)"
							}
						},
						{
							"value": "Finishing",
							"meaning": {
								"en": "Session ended, cable still connected",
								"de": "Session beendet, Kabel noch drin"
							}
						},
						{
							"value": "Reserved",
							"meaning": {
								"en": "Reserved for a future session",
								"de": "Für künftige Session reserviert"
							}
						},
						{
							"value": "Unavailable",
							"meaning": {
								"en": "Temporarily not usable",
								"de": "Vorübergehend nicht nutzbar"
							}
						},
						{
							"value": "Faulted",
							"meaning": {
								"en": "Error reported by the wallbox",
								"de": "Fehler an der Wallbox"
							}
						},
						{
							"value": "Connected",
							"meaning": {
								"en": "Vehicle connected (Enpal-specific)",
								"de": "Fahrzeug verbunden (Enpal-spezifisch)"
							}
						}
					],
					"items": [
						{
							"title": "wallbox_doc_col_value",
							"attr": "value",
							"type": "text",
							"readOnly": true,
							"width": "22%"
						},
						{
							"title": "wallbox_doc_col_meaning",
							"attr": "meaning",
							"type": "text",
							"readOnly": true,
							"width": "78%"
						}
					]
				},
